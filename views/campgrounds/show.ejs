<% layout("layouts/boilerplate") %>

<div class="row">
  <div class="col-6 mb-3">
      <div class="card">
          <img src="<%= campground.image %>" class="card-img-top" alt="">
          <div class="card-body">
            <h5 class="card-title"><%= campground.title %></h5>
            <h6 class="card-text">Suggested by: <%= campground.author.username %></h6>
          </div>
          <ul class="list-group list-group-flush">
            <li class="list-group-item"><%= campground.location %></li>
            <li class="list-group-item">$<%= campground.price %> / night</li>
            <li class="list-group-item"><%= campground.description %></li>
          </ul>
          <% if ( user && campground.author.equals(user._id)) { %>
            <div class="card-body d-flex flex-row">
              <a class="card-link btn btn-primary me-2" href="/campgrounds/<%= campground._id %>/edit">Edit</a>

              <form action="/campgrounds/<%= campground._id %>?_method=DELETE" method="post">
                <button class="btn btn-danger me-2">Delete</button>
              </form>

              <a class="btn btn-warning me-2" href="/campgrounds" class="card-link">Back</a>
            </div>
          <% } %>
        </div>
  </div>

  <div class="col-6 mb-3">
    <% if (user) { %>
      <h2>Leave a review.</h2>
      <form class="validated-form needs-validation" action="/campgrounds/<%= campground._id %>/reviews" method="post" novalidate>
        <div class="mb-3">
          <label class="form-label" for="rating" class="form-label">Rating:</label>
          <input class="form-range" id="rating" name="review[rating]" type="range" min="1" max="5" step="1">
        </div>
        <div class="mb-3">
          <label class="corm-label" for="review">Review:</label>
          <textarea class="form-control mb-3" name="review[body]" id="body" cols="30" rows="3" required></textarea>
          <div class="valid-feedback">
            Looks good.
          </div>
          <button class="btn btn-success">Submit</button>
        </div>
      </form>
    <% } %>

    <% for (let review of campground.reviews) { %>
      <div class="card mb-3">
        <div class="card-header">
          <p class="card-text">Reviewd by: <%= review.author.username %></p>
        </div>
        
        <div class="card-header">
          Rating: <%= review.rating %>
        </div>

        <div class="card-body">
          <p class="card-text"><%= review.body %></p>
          <% if (user && review.author.equals(user._id)) { %>
            <form class="needs-validation" action="/campgrounds/<%= campground._id %>/reviews/<%= review._id %>?_method=DELETE" method="post">
              <button class="btn btn-sm btn-danger">Delete</button>
            </form>
          <% } %>
        </div>
      </div>
    <% } %>
  </div>
</div>