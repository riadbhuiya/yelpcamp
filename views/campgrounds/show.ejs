<% layout("layouts/boilerplate") %>
<link rel="stylesheet" href="/public/css/stars.css">

<div class="row">
  <div class="col-6 mb-3">
      <div class="card">
          <div id="campgroundCarousel" class="carousel slide">
            <div class="carousel-inner">
              <% campground.images.forEach((image, i) => { %>
                <div class="carousel-item <%= i === 0 ? "active" : "" %>">
                  <img src="<%= image.url %>" class="d-block w-100 object-fit-scale" alt="" style="height: 200px;" >
                </div>
              <% }) %>
            </div>
            <% if (campground.images.length > 1) { %>
              <button class="carousel-control-prev" type="button" data-bs-target="#campgroundCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
              </button>
              <button class="carousel-control-next" type="button" data-bs-target="#campgroundCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
              </button>
            <% } %>
          </div>

          <div class="card-body">
            <h5 class="card-title"><%= campground.title %></h5>
            <h6 class="card-text">Suggested by: <%= campground.author.username %></h6>
          </div>
          <ul class="list-group list-group-flush">
            <li class="list-group-item"><%= campground.location %></li>
            <li class="list-group-item">$<%= campground.price %> / night</li>
            <li class="list-group-item"><%= campground.description %></li>
          </ul>
          <% if ( user && campground.author.equals(user._id)) { %>
            <div class="card-body d-flex flex-row">
              <a class="card-link btn btn-primary me-2" href="/campgrounds/<%= campground._id %>/edit">Edit</a>

              <form action="/campgrounds/<%= campground._id %>?_method=DELETE" method="post">
                <button class="btn btn-danger me-2">Delete</button>
              </form>

              <a class="btn btn-warning me-2" href="/campgrounds" class="card-link">Back</a>
            </div>
          <% } %>
        </div>
  </div>

  <div class="col-6 mb-3">
    <% if (user) { %>
      <h2>Leave a review.</h2>
      <form class="validated-form needs-validation" action="/campgrounds/<%= campground._id %>/reviews" method="post" novalidate>
        <!-- <div class="mb-3">
          <label class="form-label" for="rating" class="form-label">Rating:</label>
          <input class="form-range" id="rating" name="review[rating]" type="range" min="1" max="5" step="1">
        </div> -->
        <div class="mb-3">
          <fieldset class="starability-checkmark">
            <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
            <input type="radio" id="first-rate1" name="review[rating]" value="1" />
            <label for="first-rate1" title="Terrible">1 star</label>
            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
            <label for="first-rate2" title="Not good">2 stars</label>
            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
            <label for="first-rate3" title="Average">3 stars</label>
            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
            <label for="first-rate4" title="Very good">4 stars</label>
            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
            <label for="first-rate5" title="Amazing">5 stars</label>
          </fieldset>
        </div>

        <div class="mb-3">
          <label class="corm-label" for="review">Review text:</label>
          <textarea class="form-control mb-3" name="review[body]" id="body" cols="30" rows="3" required></textarea>
          <div class="valid-feedback">
            Looks good.
          </div>
          <button class="btn btn-success">Submit</button>
        </div>
      </form>
    <% } %>

    <% for (let review of campground.reviews) { %>
      <div class="card mb-3">
        
        <div class="card-header">
          <h5><%= review.author.username %></h5>
          <p class="starability-result" data-rating="<%= review.rating %>">
            Rated: <%= review.rating %> stars
          </p>
        </div>

        <div class="card-body">
          <p class="card-text"><%= review.body %></p>
          <% if (user && review.author.equals(user._id)) { %>
            <form class="needs-validation" action="/campgrounds/<%= campground._id %>/reviews/<%= review._id %>?_method=DELETE" method="post">
              <button class="btn btn-sm btn-danger">Delete</button>
            </form>
          <% } %>
        </div>

      </div>
    <% } %>
  </div>
</div>